@{
    ViewData["Title"] = "Administración";
}

<div class="soft-shell">
    <div class="page-header">
        <h2>Panel de administración</h2>
        <div class="module-actions">
            <a class="btn-soft btn-secondary-soft" asp-controller="Administracion" asp-action="Tickets">Ver tickets</a>
        </div>
    </div>

    <div class="summary-grid">
        <div class="soft-card summary-item">
            <div class="label">Rutas activas</div>
            <div class="value" id="active-routes">0</div>
        </div>
        <div class="soft-card summary-item">
            <div class="label">Tickets activos</div>
            <div class="value" id="active-tickets">0</div>
        </div>
        <div class="soft-card summary-item">
            <div class="label">Tickets validados</div>
            <div class="value" id="used-tickets">0</div>
        </div>
    </div>

    <section class="soft-card" style="padding:1.5rem; margin-bottom:1.5rem;">
        <div class="page-header">
            <h2>Rutas</h2>
            <div class="module-actions" style="align-items:center; gap:0.8rem;">
                <select class="form-select" id="ruta-filter" style="width:180px;">
                    <option value="all">Todos</option>
                    <option value="active">Activas</option>
                    <option value="inactive">Inactivas</option>
                </select>
                <button class="btn-soft btn-primary-soft" data-bs-toggle="modal" data-bs-target="#rutaModal" id="new-ruta-btn">Nueva ruta</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Precio</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="rutas-body">
                    <tr>
                        <td colspan="6" class="empty-state">Cargando rutas...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted" id="ruta-meta">Mostrando 0 resultados</div>
            <div class="btn-group" id="ruta-pagination" role="group" aria-label="Paginación rutas"></div>
        </div>
    </section>
</div>

<div class="modal fade" id="rutaModal" tabindex="-1" aria-labelledby="rutaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-card">
            <div class="modal-header">
                <h5 class="modal-title" id="rutaModalLabel">Guardar ruta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="ruta-form">
                <div class="modal-body">
                    <input type="hidden" id="ruta-id" />
                    <div class="mb-3">
                        <label class="form-label" for="ruta-nombre">Nombre</label>
                        <input type="text" class="form-control" id="ruta-nombre" required>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="ruta-origen">Origen</label>
                            <input type="text" class="form-control" id="ruta-origen" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ruta-destino">Destino</label>
                            <input type="text" class="form-control" id="ruta-destino" required>
                        </div>
                    </div>
                    <div class="row g-3 mt-0">
                        <div class="col-md-6">
                            <label class="form-label" for="ruta-precio">Precio</label>
                            <input type="number" step="0.01" min="0.01" class="form-control" id="ruta-precio" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ruta-estado">Estado</label>
                            <select class="form-select" id="ruta-estado">
                                <option value="true">Activa</option>
                                <option value="false">Inactiva</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-soft btn-secondary-soft" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-soft btn-primary-soft">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="toast-container" id="toast-container" aria-live="polite" aria-atomic="true"></div>

@section Scripts {
    <script>
        const rutasBody = document.getElementById('rutas-body');
        const activeRoutes = document.getElementById('active-routes');
        const activeTickets = document.getElementById('active-tickets');
        const usedTickets = document.getElementById('used-tickets');
        const rutaForm = document.getElementById('ruta-form');
        const rutaModal = new bootstrap.Modal(document.getElementById('rutaModal'));
        const rutaFilter = document.getElementById('ruta-filter');
        const rutaPagination = document.getElementById('ruta-pagination');
        const rutaMeta = document.getElementById('ruta-meta');

        const routeState = { page: 1, pageSize: 5, filter: 'all', allRoutes: [] };

        async function loadRoutes() {
            try {
                const response = await fetch(`/api/rutas?pageNumber=${routeState.page}&pageSize=${routeState.pageSize}`);
                if (!response.ok) throw new Error('No se pudieron cargar las rutas');
                const data = await response.json();
                const items = data.data || data.items || [];
                routeState.allRoutes = items;
                renderRoutes(items);
                activeRoutes.textContent = items.filter(r => r.estado).length;
                renderRoutePagination(items.length, data.totalRecords || items.length);
            } catch (error) {
                rutasBody.innerHTML = '<tr><td colspan="6" class="empty-state">' + error.message + '</td></tr>';
            }
        }

        async function loadTicketsSummary() {
            try {
                const response = await fetch('/api/tickets?pageNumber=1&pageSize=100');
                if (!response.ok) throw new Error('No se pudieron cargar los tickets');
                const data = await response.json();
                const items = data.data || data.items || [];
                activeTickets.textContent = items.filter(t => t.estado === 'Active').length;
                usedTickets.textContent = items.filter(t => t.estado === 'Used').length;
            } catch (error) {
                activeTickets.textContent = '0';
                usedTickets.textContent = '0';
            }
        }

        function renderRoutes(routes) {
            const filtered = routes.filter((ruta) => {
                if (routeState.filter === 'active') return ruta.estado === true;
                if (routeState.filter === 'inactive') return ruta.estado === false;
                return true;
            });

            if (!filtered.length) {
                rutasBody.innerHTML = '<tr><td colspan="6" class="empty-state">No hay rutas registradas para este filtro.</td></tr>';
                rutaMeta.textContent = 'Mostrando 0 resultados';
                return;
            }

            rutaMeta.textContent = `Mostrando ${filtered.length} resultado${filtered.length > 1 ? 's' : ''}`;
            rutasBody.innerHTML = filtered.map((ruta) => `
                <tr>
                    <td>${ruta.nombre}</td>
                    <td>${ruta.origen}</td>
                    <td>${ruta.destino}</td>
                    <td>${formatMoney(ruta.precio)}</td>
                    <td><span class="status-badge ${ruta.estado ? 'status-active' : 'status-inactive'}">${ruta.estado ? 'Activa' : 'Inactiva'}</span></td>
                    <td>
                        <div class="table-actions">
                            <button class="btn-icon primary" data-action="edit" data-id="${ruta.id}">Editar</button>
                            <button class="btn-icon danger" data-action="delete" data-id="${ruta.id}">Eliminar</button>
                        </div>
                    </td>
                </tr>
            `).join('');

            rutasBody.querySelectorAll('[data-action="edit"]').forEach((button) => {
                button.addEventListener('click', () => openRutaModal(button.dataset.id));
            });

            rutasBody.querySelectorAll('[data-action="delete"]').forEach((button) => {
                button.addEventListener('click', () => deleteRuta(button.dataset.id));
            });
        }

        function renderRoutePagination(currentItemsCount, totalRecords) {
            const totalPages = Math.max(1, Math.ceil(totalRecords / routeState.pageSize));
            rutaPagination.innerHTML = '';

            const prev = document.createElement('button');
            prev.type = 'button';
            prev.className = 'btn-soft btn-secondary-soft';
            prev.textContent = 'Anterior';
            prev.disabled = routeState.page === 1;
            prev.addEventListener('click', () => {
                if (routeState.page > 1) {
                    routeState.page -= 1;
                    loadRoutes();
                }
            });
            rutaPagination.appendChild(prev);

            const pageLabel = document.createElement('span');
            pageLabel.className = 'btn-soft btn-secondary-soft';
            pageLabel.style.cursor = 'default';
            pageLabel.textContent = `Página ${routeState.page} / ${totalPages}`;
            rutaPagination.appendChild(pageLabel);

            const next = document.createElement('button');
            next.type = 'button';
            next.className = 'btn-soft btn-primary-soft';
            next.textContent = 'Siguiente';
            next.disabled = routeState.page >= totalPages;
            next.addEventListener('click', () => {
                if (routeState.page < totalPages) {
                    routeState.page += 1;
                    loadRoutes();
                }
            });
            rutaPagination.appendChild(next);
        }

        function formatMoney(value) {
            return new Intl.NumberFormat('es-DO', { style: 'currency', currency: 'DOP' }).format(value || 0);
        }

        function showToast(message) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast-box';
            toast.textContent = message;
            container.appendChild(toast);
            requestAnimationFrame(() => toast.classList.add('show'));
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 200);
            }, 2600);
        }

        function openRutaModal(id) {
            const modalLabel = document.getElementById('rutaModalLabel');
            const rutaId = document.getElementById('ruta-id');
            const nombre = document.getElementById('ruta-nombre');
            const origen = document.getElementById('ruta-origen');
            const destino = document.getElementById('ruta-destino');
            const precio = document.getElementById('ruta-precio');
            const estado = document.getElementById('ruta-estado');

            if (!id) {
                modalLabel.textContent = 'Nueva ruta';
                rutaId.value = '';
                rutaForm.reset();
                estado.value = 'true';
                rutaModal.show();
                return;
            }

            fetch('/api/rutas?pageNumber=1&pageSize=100')
                .then((response) => response.json())
                .then((data) => {
                    const items = data.data || data.items || [];
                    const ruta = items.find(item => String(item.id) === String(id));
                    if (!ruta) return;
                    modalLabel.textContent = 'Editar ruta';
                    rutaId.value = ruta.id;
                    nombre.value = ruta.nombre;
                    origen.value = ruta.origen;
                    destino.value = ruta.destino;
                    precio.value = ruta.precio;
                    estado.value = String(ruta.estado);
                    rutaModal.show();
                });
        }

        async function deleteRuta(id) {
            if (!confirm('¿Deseas eliminar esta ruta?')) return;
            try {
                const response = await fetch(`/api/rutas/${id}`, { method: 'DELETE' });
                if (!response.ok) throw new Error('No se pudo eliminar la ruta');
                showToast('Ruta eliminada');
                await loadRoutes();
            } catch (error) {
                showToast(error.message);
            }
        }

        rutaForm.addEventListener('submit', async function (event) {
            event.preventDefault();
            const id = document.getElementById('ruta-id').value;
            const payload = {
                nombre: document.getElementById('ruta-nombre').value,
                origen: document.getElementById('ruta-origen').value,
                destino: document.getElementById('ruta-destino').value,
                precio: Number(document.getElementById('ruta-precio').value),
                estado: document.getElementById('ruta-estado').value === 'true'
            };

            try {
                const url = id ? `/api/rutas/${id}` : '/api/rutas';
                const method = id ? 'PUT' : 'POST';
                const response = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    const errorBody = await response.text();
                    throw new Error(errorBody || 'No se pudo guardar la ruta');
                }

                showToast(id ? 'Ruta actualizada' : 'Ruta creada');
                rutaModal.hide();
                routeState.page = 1;
                await loadRoutes();
            } catch (error) {
                showToast(error.message);
            }
        });

        document.getElementById('new-ruta-btn').addEventListener('click', () => openRutaModal());
        rutaFilter.addEventListener('change', (event) => {
            routeState.filter = event.target.value;
            routeState.page = 1;
            loadRoutes();
        });

        loadRoutes();
        loadTicketsSummary();
    </script>
}
