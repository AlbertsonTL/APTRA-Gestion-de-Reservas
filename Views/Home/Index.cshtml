@{
    ViewData["Title"] = "Selecciona tu rol";
}

<div class="role-selector soft-shell">
    <div class="role-panel">
        <h1>Seleccione su rol para continuar</h1>
        <p>Accede al módulo correspondiente según tu perfil dentro del sistema de reservas.</p>

        <div class="role-options">
            <a class="role-card" asp-controller="Administracion" asp-action="Index">
                <span>Administración</span>
            </a>
            <a class="role-card" asp-controller="Cajero" asp-action="Index">
                <span>Cajero</span>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.role-card').forEach(function (card) {
                card.addEventListener('click', function () {
                    card.style.transform = 'scale(0.98)';
                });
            });
        });
    </script>
}
